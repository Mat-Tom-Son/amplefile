#!/usr/bin/env sh
set -eu
script_path=$0
if [ "$(uname -s)" = "Linux" ]; then script_path=$(readlink -f -- "$0"); fi
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
if [ "$(uname -s)" = "Darwin" ]; then
  exec /usr/bin/osascript -l JavaScript "$script_dir/amplefile-cli.jxa.js" "$script_dir" "$@"
fi
if [ "$(uname -s)" = "Linux" ]; then exec "$script_dir/amplefile-cli" "$@"; fi
echo "amplefile: this command requires macOS or Linux." >&2
exit 1
